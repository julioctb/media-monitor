# Postgres connection string (psycopg driver)
DATABASE_URL=postgresql+psycopg://media:media@localhost:5432/mediamonitor

# Client scope for API and workers (single-tenant MVP; id 1 is seeded)
DEFAULT_CLIENT_ID=1

# X/Twitter third-party provider (twitterapi.io-compatible)
X_PROVIDER_API_KEY=
X_PROVIDER_BASE_URL=https://api.twitterapi.io
# Client-side rate limit: max search requests per minute
X_PROVIDER_RATE_PER_MIN=10

# Facebook Pages via Graph API (client-owned pages): JSON list of
# {"page_id", "token", "label"} with one page access token per page.
# Empty/unset disables the adapter.
FB_PAGES=
# Pinned latest stable Graph API version
FB_GRAPH_API_VERSION=v26.0

# SMTP for alert emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM=alerts@example.com

# Ingest polling interval (minutes)
INGEST_INTERVAL_MIN=15

# Frontend (SvelteKit dashboard)
# API base URL used server-side by the dashboard (SSR load/form actions).
# docker compose pins http://api:8000 for the dashboard service; this value
# is for native/local runs.
API_BASE_URL=http://localhost:8000
# Public origin of the dashboard, used by adapter-node for the CSRF/form
# action check. Must match the URL users browse to, or form POSTs 403.
# docker compose pins http://localhost:3000 for the dashboard service.
ORIGIN=http://localhost:3000
